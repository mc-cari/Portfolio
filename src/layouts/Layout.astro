---
import Analytics from '@vercel/analytics/astro';

export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Mauricio Cari Leal - Software Developer Portfolio" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico?v=1" />
		<link rel="shortcut icon" href="/favicon.ico?v=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="antialiased">
		<slot />
		<!-- @ts-expect-error Vercel's Astro entry is valid at build time but isn't typed as an Astro component by Astro 4's checker. -->
		<Analytics />
	</body>
</html>

<style is:global>
	:root {
		--forest-ink: #06100a;
		--forest-deep: #0b1910;
		--forest-surface: #122219;
		--forest-surface-strong: #172b1d;
		--forest-green: #31533a;
		--sage: #b7c1ad;
		--muted: #8e9f8b;
		--olive: #c6d58f;
		--ivory: #faf9f6;
		--ivory-muted: #e0e5d9;
		--forest-line: rgba(198, 213, 143, .2);
	}

	* { box-sizing: border-box; }

	html {
		background: var(--forest-ink);
		scroll-padding-top: 7rem;
	}

	body {
		position: relative;
		min-height: 100vh;
		margin: 0;
		font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		background:
			url("data:image/svg+xml,%3Csvg width='420' height='420' viewBox='0 0 420 420' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23c6d58f' stroke-opacity='.045'%3E%3Cpath d='M-30 98c83-65 150 15 230-17s135-4 237 42'/%3E%3Cpath d='M-42 131c91-71 160 18 247-18s145-3 249 47'/%3E%3Cpath d='M-50 166c98-78 171 18 262-19s150 0 260 52'/%3E%3Cpath d='M-26 286c75-60 148-9 207-44s144-29 267 17'/%3E%3Cpath d='M-48 322c87-72 162-16 230-53s155-27 284 25'/%3E%3Cpath d='M64-25c-5 91 53 126 26 201s5 141 79 249'/%3E%3C/g%3E%3C/svg%3E") repeat,
			radial-gradient(circle at 8% 5%, rgba(49, 83, 58, .38), transparent 29rem),
			linear-gradient(155deg, var(--forest-deep), var(--forest-ink) 42%, #040a06);
		color: var(--ivory-muted);
	}

	.skip-link {
		position: fixed;
		z-index: 100;
		top: .75rem;
		left: 1rem;
		transform: translateY(-160%);
		padding: .65rem .9rem;
		border-radius: .5rem;
		background: var(--olive);
		color: var(--forest-ink);
		font-size: .8rem;
		font-weight: 800;
		transition: transform .2s ease;
	}

	.skip-link:focus { transform: translateY(0); }

	::selection {
		background: var(--olive);
		color: var(--forest-ink);
	}

	h1, h2, h3, h4 {
		font-family: 'FreeSerif', Georgia, serif;
		text-wrap: balance;
	}

	a:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--olive);
		outline-offset: 4px;
	}

	.glass-card {
		border: 1px solid var(--forest-line);
		background: linear-gradient(145deg, rgba(23, 43, 29, .96), rgba(10, 20, 12, .98));
		box-shadow: inset 0 1px 0 rgba(250, 249, 246, .04), 0 24px 60px rgba(2, 8, 3, .28);
	}

	.section-shell {
		position: relative;
		padding-block: 7.5rem;
		scroll-margin-top: 5rem;
	}

	.section-shell + .section-shell {
		border-top: 1px solid rgba(198, 213, 143, .1);
	}

	.section-heading {
		max-width: 44rem;
	}

	.section-heading.centered {
		margin-inline: auto;
		text-align: center;
	}

	.section-title {
		margin: 0;
		color: var(--ivory);
		font-size: clamp(2.25rem, 5vw, 3.7rem);
		font-weight: 700;
		letter-spacing: -.035em;
		line-height: .98;
	}

	.body-copy {
		color: var(--sage);
		font-size: 1rem;
		line-height: 1.75;
		letter-spacing: .005em;
	}

	.topic-tag,
	.tech-pill {
		display: inline-flex;
		align-items: center;
		gap: .45rem;
		border: 1px solid rgba(198, 213, 143, .22);
		border-radius: 999px;
		background: rgba(49, 83, 58, .38);
		color: var(--ivory-muted);
		font-size: .72rem;
		font-weight: 700;
		letter-spacing: .02em;
	}

	.topic-tag { padding: .55rem .8rem; }
	.tech-pill { padding: .4rem .65rem; color: var(--sage); }

	.project-visual { transition: transform .3s ease, border-color .3s ease; }
	.project-item:hover .project-visual { transform: translateY(-.35rem); border-color: rgba(198, 213, 143, .44); }

	.forest-link {
		color: var(--olive);
		font-weight: 700;
		text-underline-offset: .25em;
		transition: color .2s ease;
	}

	.forest-link:hover { color: var(--ivory); }

	.forest-button-primary,
	.forest-button-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.85rem;
		padding: .75rem 1.15rem;
		border-radius: .45rem;
		font-size: .9rem;
		font-weight: 700;
		transition: transform .2s ease, background .2s ease, border-color .2s ease, color .2s ease;
	}

	.forest-button-primary {
		border: 1px solid var(--olive);
		background: var(--olive);
		color: var(--forest-ink);
	}

	.forest-button-secondary {
		border: 1px solid rgba(198, 213, 143, .32);
		background: rgba(49, 83, 58, .42);
		color: var(--ivory);
	}

	.forest-button-primary:hover,
	.forest-button-secondary:hover {
		transform: translateY(-2px);
		border-color: var(--ivory);
	}

	.forest-button-primary:hover { background: var(--ivory); }
	.forest-button-secondary:hover { background: rgba(45, 74, 43, .75); }

	.hero-stage {
		position: relative;
		display: grid;
		min-height: calc(100vh - 3rem);
		align-items: center;
		padding-block: 5rem 7rem;
	}

	.hero-main { position: relative; z-index: 1; max-width: 64rem; }

	.hero-title {
		max-width: 14ch;
		margin: 0;
		padding-block: .06em .1em;
		color: var(--ivory);
		font-size: clamp(3rem, 6.2vw, 5.25rem);
		font-weight: 700;
		letter-spacing: -.045em;
		line-height: .94;
	}

	.hero-name,
	.hero-title-accent { display: block; }
	.hero-title-accent { margin-top: .12em; color: var(--olive); font-size: .9em; }
	.hero-copy { max-width: 42rem; margin-top: 2rem; }
	.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 2.25rem; }
	.hero-socials { display: flex; flex-wrap: wrap; gap: 1.2rem; }

	.site-header {
		position: fixed;
		z-index: 50;
		top: 1rem;
		left: 50%;
		width: min(calc(100% - 2rem), 72rem);
		transform: translateX(-50%);
		border: 1px solid rgba(164, 172, 134, .2);
		border-radius: .9rem;
		background: rgba(6, 16, 10, .92);
		box-shadow: 0 12px 36px rgba(1, 5, 2, .34);
	}

	.site-nav { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding: .72rem 1.25rem; }
	.site-brand { display: inline-flex; align-items: center; flex: 0 0 auto; color: var(--ivory); font-size: .78rem; font-weight: 800; letter-spacing: .02em; }
	.site-nav-links { display: flex; align-items: center; gap: clamp(.75rem, 3vw, 2rem); }
	.site-nav a { color: var(--sage); font-size: .75rem; font-weight: 700; letter-spacing: .035em; transition: color .2s ease; }
	.site-nav a:hover { color: var(--ivory); }
	.site-nav-cta { padding: .5rem .75rem; border: 1px solid rgba(198, 213, 143, .32); border-radius: .4rem; color: var(--olive) !important; }

	.profile-frame {
		position: relative;
		padding: .55rem;
		border: 1px solid rgba(164, 172, 134, .3);
		border-radius: 10rem 10rem .5rem .5rem;
		background: rgba(49, 83, 58, .42);
	}

	.profile-frame img { border-radius: 9.5rem 9.5rem .3rem .3rem; filter: saturate(.78) contrast(1.04); }

	@media (max-width: 640px) {
		.section-shell { padding-block: 5rem; }
		.site-header { top: .55rem; width: calc(100% - 1rem); border-radius: .7rem; }
		.site-nav { gap: 1rem; padding-inline: .75rem; }
		.site-nav-cta { display: none; }
		.site-nav-links { gap: .9rem; overflow-x: auto; }
		.site-nav a { font-size: .68rem; white-space: nowrap; }
		.hero-stage { min-height: auto; padding-top: 7rem; }
		.hero-title { max-width: 10ch; font-size: clamp(3rem, 14vw, 4.6rem); line-height: .96; }
		.hero-copy { max-width: 34rem; }
		.hero-actions { align-items: flex-start; flex-direction: column; }
		.hero-socials { gap: 1rem; }
	}

	.timeline-item h3 {
		position: relative;
	}
	.timeline-item h3::before {
		content: '';
		position: absolute;
		left: -2.25rem;
		top: 50%;
		transform: translateY(-50%);
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background-color: var(--olive);
		border: 2px solid var(--forest-ink);
	}

	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after { scroll-behavior: auto !important; }
	}
</style>
