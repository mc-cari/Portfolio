---
import 'mapbox-gl/dist/mapbox-gl.css';

const mapboxToken = import.meta.env.MAPBOX_TOKEN ?? '';

const stops = [
	{
		id: 'valdivia-2019',
		city: 'Valdivia',
		country: 'Chile',
		year: '2019',
		venue: 'Universidad Austral de Chile',
		event: 'Competitive Programming Winter Camp',
		result: 'Training camp',
		detail: 'First training camp attended, two weeks of competition + classes',
		coordinates: [-73.2392, -39.8176],
		zoom: 5.2,
		color: '#34d399',
	},
	{
		id: 'baku-2019',
		city: 'Baku',
		country: 'Azerbaijan',
		year: '2019',
		venue: 'National Gymnastics Arena',
		event: 'International Olympiad in Informatics',
		result: '#204 worldwide',
		detail: 'Part of the four members of Team Chile, placing 204th among 325 high school programmers and in first place in the Chilean team.',
		coordinates: [49.9166, 40.4192],
		zoom: 5.2,
		color: '#60a5fa',
	},
	{
		id: 'campinas-2023',
		city: 'Campinas',
		country: 'Brazil',
		year: '2023',
		venue: 'University of Campinas · Unicamp',
		event: 'Brazilian ICPC Summer School',
		result: 'Training camp',
		detail: 'Attended the World Final Class in Campinas: 85 hours of training, from January 23 to February 4.',
		coordinates: [-47.0647, -22.8176],
		zoom: 5.2,
		color: '#34d399',
	},
	{
		id: 'buenos-aires-2023',
		city: 'Buenos Aires',
		country: 'Argentina',
		year: '2023',
		venue: 'Universidad Nacional de La Matanza',
		event: 'Training Camp Argentina',
		result: 'Training camp',
		detail: 'Completed 90 hours of competitive-programming training, from July 31 to August 11.',
		coordinates: [-58.5628, -34.6695],
		zoom: 5.2,
		color: '#34d399',
	},
	{
		id: 'coquimbo-2023',
		city: 'Coquimbo',
		country: 'Chile',
		year: '2023',
		venue: 'Universidad Católica del Norte · Campus Guayacán',
		event: 'ICPC Latin American Regional',
		result: '#23 in Latin America',
		detail: 'Achieved 23rd place among 309 teams in Latin America.',
		coordinates: [-71.351, -29.96495],
		zoom: 5.2,
		color: '#c084fc',
	},
	{
		id: 'mumbai-2024',
		city: 'Mumbai',
		country: 'India',
		year: '2024',
		venue: 'TCS Olympus Centre · Thane',
		event: 'TCS CodeVita Season 11',
		result: '#10 worldwide',
		detail: 'Secured 10th place in the Grand Finale out of 25 participants and 100,000+ overall participants.',
		coordinates: [72.98856, 19.25958],
		zoom: 5.2,
		color: '#fb923c',
	},
	{
		id: 'chennai-2025',
		city: 'Chennai',
		country: 'India',
		year: '2025',
		venue: 'TCS Siruseri Campus',
		event: 'TCS CodeVita Season 12',
		result: '#4 worldwide',
		detail: 'Achieved 4th place in the Grand Finale out of 25 participants and 100,000+ overall participants.',
		coordinates: [80.21772, 12.82955],
		zoom: 5.2,
		color: '#facc15',
	},
];
---

<div class="competition-atlas" data-competition-atlas data-mapbox-token={mapboxToken}>
	<div class="atlas-shell">
		<div class="atlas-map-wrap">
			<div id="competition-map" class="atlas-map" aria-label="Interactive globe showing Mauricio's in-person competition history"></div>
			<div class="atlas-map-vignette" aria-hidden="true"></div>
			<div class="atlas-map-status" data-map-status>
				<span class="atlas-loader" aria-hidden="true"></span>
				<span>Loading map…</span>
			</div>
			<button type="button" class="atlas-play" data-map-play aria-pressed="false">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 8 6-8 6V6Z"/></svg>
				<span data-map-play-label>Follow the route</span>
			</button>
		</div>

		<aside class="atlas-story" aria-label="Competition journey timeline">
			<div class="atlas-current" aria-live="polite">
				<div class="atlas-current-topline">
					<span data-detail-year>2019</span>
					<span data-detail-progress>01 / 07</span>
				</div>
				<p class="atlas-current-place"><span data-detail-city>Valdivia</span>, <span data-detail-country>Chile</span></p>
				<h4 data-detail-event>Competitive Programming Training Camp</h4>
				<p class="atlas-current-result" data-detail-result>Training camp</p>
				<p class="atlas-current-venue">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11Z"/><circle cx="12" cy="10" r="2"/></svg>
					<span data-detail-venue>Universidad Austral de Chile</span>
				</p>
				<p class="atlas-current-copy" data-detail-copy>Competitive-programming training camp at Universidad Austral de Chile.</p>
			</div>

			<div class="atlas-stops">
				{stops.map((stop, index) => (
					<button
						type="button"
						class:list={['atlas-stop', { active: index === 0 }]}
						data-stop-index={index}
						aria-pressed={index === 0 ? 'true' : 'false'}
					>
						<span class="atlas-stop-dot" style={`--stop-color: ${stop.color}`}></span>
						<span class="atlas-stop-year">{stop.year}</span>
						<span class="atlas-stop-name">{stop.city}</span>
					</button>
				))}
			</div>

		</aside>
	</div>
	<script is:inline type="application/json" data-map-stops set:html={JSON.stringify(stops)}></script>
</div>

<script>
	import type { Map as MapboxMap } from 'mapbox-gl';

	type Stop = {
		id: string;
		city: string;
		country: string;
		year: string;
		event: string;
		result: string;
		detail: string;
		venue: string;
		coordinates: [number, number];
		zoom: number;
		color: string;
	};

	const atlas = document.querySelector<HTMLElement>('[data-competition-atlas]');

	if (atlas) {
		const stopData = atlas.querySelector<HTMLScriptElement>('[data-map-stops]');
		const stops: Stop[] = stopData ? JSON.parse(stopData.textContent || '[]') : [];
		const token = atlas.dataset.mapboxToken || '';
		const status = atlas.querySelector<HTMLElement>('[data-map-status]');
		const mapElement = atlas.querySelector<HTMLElement>('#competition-map');
		const stopButtons = [...atlas.querySelectorAll<HTMLButtonElement>('[data-stop-index]')];
		const playButton = atlas.querySelector<HTMLButtonElement>('[data-map-play]');
		const playLabel = atlas.querySelector<HTMLElement>('[data-map-play-label]');
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let map: MapboxMap | undefined;
		let activeIndex = 0;
		let isPlaying = false;

		const setText = (selector: string, value: string) => {
			const element = atlas.querySelector<HTMLElement>(selector);
			if (element) element.textContent = value;
		};

		const showStop = (index: number, moveCamera = true, cameraSpeed = prefersReducedMotion ? 100 : 0.42) => {
			const stop = stops[index];
			if (!stop) return;
			activeIndex = index;
			setText('[data-detail-year]', stop.year);
			setText('[data-detail-progress]', `${String(index + 1).padStart(2, '0')} / ${String(stops.length).padStart(2, '0')}`);
			setText('[data-detail-city]', stop.city);
			setText('[data-detail-country]', stop.country);
			setText('[data-detail-event]', stop.event);
			setText('[data-detail-result]', stop.result);
			setText('[data-detail-venue]', stop.venue);
			setText('[data-detail-copy]', stop.detail);
			stopButtons.forEach((button, buttonIndex) => {
				const selected = buttonIndex === index;
				button.classList.toggle('active', selected);
				button.setAttribute('aria-pressed', String(selected));
			});
			if (map?.isStyleLoaded()) {
				map.setFeatureState({ source: 'competition-stops', id: stop.id }, { selected: true });
				stops.forEach((otherStop, otherIndex) => {
					if (otherIndex !== index) map?.setFeatureState({ source: 'competition-stops', id: otherStop.id }, { selected: false });
				});
				if (moveCamera) {
					map.flyTo({ center: stop.coordinates, zoom: stop.zoom, speed: cameraSpeed, curve: 1.2, essential: false });
				}
			}
		};

		const setPlaying = (playing: boolean) => {
			isPlaying = playing;
			playButton?.setAttribute('aria-pressed', String(playing));
			if (playLabel) playLabel.textContent = playing ? 'Stop route' : 'Follow the route';
		};

		const wait = (milliseconds: number) => new Promise<void>((resolve) => window.setTimeout(resolve, milliseconds));

		const playJourney = async () => {
			if (isPlaying) {
				setPlaying(false);
				return;
			}
			setPlaying(true);
			for (let index = activeIndex; index < stops.length; index += 1) {
				if (!isPlaying) return;
				showStop(index);
				await wait(prefersReducedMotion ? 850 : 5200);
			}
			setPlaying(false);
		};

		stopButtons.forEach((button) => {
			button.addEventListener('click', () => {
				setPlaying(false);
				showStop(Number(button.dataset.stopIndex), true, prefersReducedMotion ? 100 : 1.15);
			});
		});
		playButton?.addEventListener('click', playJourney);

		const initMap = async () => {
			if (!mapElement || map || !stops.length) return;
			if (!token) {
				status?.classList.add('error');
				if (status) status.textContent = 'Add MAPBOX_TOKEN to .env to render the competition atlas.';
				return;
			}
			const { default: mapboxgl } = await import('mapbox-gl');

			map = new mapboxgl.Map({
				container: mapElement,
				accessToken: token,
				style: 'mapbox://styles/mapbox/dark-v11',
				projection: 'globe',
				center: [5, 12],
				zoom: 1.25,
				bearing: -8,
				pitch: 8,
				minZoom: 0.8,
				maxZoom: 13,
				cooperativeGestures: true,
				attributionControl: false,
			});
			map.addControl(new mapboxgl.NavigationControl({ showCompass: false }), 'top-right');
			map.addControl(new mapboxgl.AttributionControl({ compact: true }), 'bottom-left');

			map.on('style.load', () => {
				map?.setFog({
					color: 'rgb(35, 45, 70)',
					'high-color': 'rgb(13, 23, 48)',
					'horizon-blend': 0.08,
					'space-color': 'rgb(3, 7, 18)',
					'star-intensity': 0.42,
				});
			});

			map.on('load', () => {
				const features = stops.map((stop, index) => ({
					type: 'Feature' as const,
					id: stop.id,
					properties: { ...stop, coordinates: undefined, index },
					geometry: { type: 'Point' as const, coordinates: stop.coordinates },
				}));
				const route = {
					type: 'Feature' as const,
					properties: {},
					geometry: { type: 'LineString' as const, coordinates: stops.map((stop) => stop.coordinates) },
				};

				map?.addSource('competition-route', { type: 'geojson', data: route, lineMetrics: true });
				map?.addLayer({
					id: 'competition-route-halo',
					type: 'line',
					source: 'competition-route',
					paint: { 'line-color': '#38bdf8', 'line-width': 7, 'line-opacity': 0.1, 'line-blur': 5 },
				});
				map?.addLayer({
					id: 'competition-route-line',
					type: 'line',
					source: 'competition-route',
					layout: { 'line-cap': 'round', 'line-join': 'round' },
					paint: {
						'line-width': ['interpolate', ['linear'], ['zoom'], 1, 1.4, 6, 3],
						'line-opacity': 0.75,
						'line-gradient': ['interpolate', ['linear'], ['line-progress'], 0, '#60a5fa', 0.4, '#c084fc', 0.72, '#fb923c', 1, '#facc15'],
					},
				});

				map?.addSource('competition-stops', { type: 'geojson', data: { type: 'FeatureCollection', features }, generateId: false });
				map?.addLayer({
					id: 'competition-stop-pulse',
					type: 'circle',
					source: 'competition-stops',
					paint: {
						'circle-radius': ['case', ['boolean', ['feature-state', 'selected'], false], 18, 10],
						'circle-color': ['get', 'color'],
						'circle-opacity': ['case', ['boolean', ['feature-state', 'selected'], false], 0.2, 0.08],
						'circle-blur': 0.35,
					},
				});
				map?.addLayer({
					id: 'competition-stop-points',
					type: 'circle',
					source: 'competition-stops',
					paint: {
						'circle-radius': ['case', ['boolean', ['feature-state', 'selected'], false], 7, 5],
						'circle-color': ['get', 'color'],
						'circle-stroke-color': '#f8fafc',
						'circle-stroke-width': 2,
					},
				});
				map?.addLayer({
					id: 'competition-stop-labels',
					type: 'symbol',
					source: 'competition-stops',
					minzoom: 1.4,
					layout: {
						'text-field': ['format', ['get', 'city'], { 'font-scale': 1 }, '\n', {}, ['get', 'year'], { 'font-scale': 0.8 }],
						'text-font': ['DIN Pro Medium', 'Arial Unicode MS Regular'],
						'text-size': 12,
						'text-offset': [0, 1.8],
						'text-anchor': 'top',
						'text-allow-overlap': false,
					},
					paint: { 'text-color': '#e2e8f0', 'text-halo-color': '#0f172a', 'text-halo-width': 1.5 },
				});

				map?.on('click', 'competition-stop-points', (event) => {
					const index = Number(event.features?.[0]?.properties?.index);
					if (Number.isFinite(index)) {
						setPlaying(false);
						showStop(index);
					}
				});
				map?.on('mouseenter', 'competition-stop-points', () => { if (map) map.getCanvas().style.cursor = 'pointer'; });
				map?.on('mouseleave', 'competition-stop-points', () => { if (map) map.getCanvas().style.cursor = ''; });
				showStop(activeIndex, false);
				status?.classList.add('loaded');
			});

			map.on('error', (event) => {
				if (!map?.loaded() && status) {
					status.classList.add('error');
					status.textContent = 'The map could not load. The journey is still available in the timeline.';
				}
				console.error('Competition map error:', event.error);
			});
		};

		if ('IntersectionObserver' in window) {
			const observer = new IntersectionObserver((entries) => {
				if (entries.some((entry) => entry.isIntersecting)) {
					initMap();
					observer.disconnect();
				}
			}, { rootMargin: '300px' });
			observer.observe(atlas);
		} else {
			initMap();
		}
	}
</script>

<style>
	.competition-atlas {
		margin: 4rem auto 0;
		max-width: 72rem;
		container-type: inline-size;
	}

	.atlas-heading {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(16rem, 28rem);
		align-items: end;
		gap: 2rem;
		margin-bottom: 1.5rem;
	}

	.atlas-heading h3 {
		margin: 0;
		color: #f8fafc;
		font-size: clamp(1.6rem, 3vw, 2.25rem);
		font-weight: 700;
		letter-spacing: -.035em;
	}

	.atlas-intro {
		margin: 0;
		color: #94a3b8;
		font-size: .92rem;
		line-height: 1.65;
	}

	.atlas-shell {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		overflow: hidden;
		border: 1px solid rgba(71, 85, 105, .55);
		border-radius: 1.25rem;
		background: #07101f;
		box-shadow: 0 30px 80px rgba(2, 6, 23, .45), inset 0 1px 0 rgba(255, 255, 255, .03);
	}

	.atlas-map-wrap {
		position: relative;
		min-height: 32rem;
		isolation: isolate;
	}

	.atlas-map {
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 52% 45%, #172554, #030712 72%);
	}

	.atlas-map-vignette {
		position: absolute;
		z-index: 1;
		inset: 0;
		pointer-events: none;
		box-shadow: inset -50px 0 70px -45px #07101f, inset 0 -70px 80px -70px #020617;
	}

	.atlas-map-status {
		position: absolute;
		z-index: 3;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: .75rem;
		color: #94a3b8;
		font-size: .8rem;
		letter-spacing: .04em;
		background: radial-gradient(circle at center, rgba(15, 23, 42, .45), rgba(2, 6, 23, .92));
		transition: opacity .5s ease, visibility .5s ease;
	}

	.atlas-map-status.loaded {
		opacity: 0;
		visibility: hidden;
	}

	.atlas-map-status.error {
		padding: 2rem;
		color: #fda4af;
		text-align: center;
	}

	.atlas-loader {
		width: .85rem;
		height: .85rem;
		border: 1px solid rgba(56, 189, 248, .25);
		border-top-color: #38bdf8;
		border-radius: 50%;
		animation: atlas-spin 1s linear infinite;
	}

	.atlas-play {
		position: absolute;
		z-index: 2;
		right: 1rem;
		bottom: 1rem;
		display: flex;
		align-items: center;
		gap: .5rem;
		padding: .55rem .8rem;
		border: 1px solid rgba(148, 163, 184, .16);
		border-radius: 999px;
		background: rgba(2, 6, 23, .68);
		backdrop-filter: blur(10px);
		color: #94a3b8;
		font-size: .65rem;
		font-weight: 600;
		letter-spacing: .08em;
		text-transform: uppercase;
		cursor: pointer;
		transition: color .2s ease, border-color .2s ease, background .2s ease;
	}

	.atlas-play:hover,
	.atlas-play:focus-visible,
	.atlas-play[aria-pressed="true"] { color: #e0f2fe; border-color: rgba(56, 189, 248, .5); background: rgba(3, 105, 161, .2); outline: none; }
	.atlas-play svg { width: .85rem; fill: currentColor; }

	.atlas-story {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		padding: 2rem;
		border-top: 1px solid rgba(71, 85, 105, .4);
		background: linear-gradient(155deg, rgba(15, 23, 42, .96), rgba(7, 16, 31, .98));
	}

	.atlas-current-topline {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.7rem;
		color: #64748b;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: .65rem;
		letter-spacing: .13em;
	}

	.atlas-current-place { margin: 0 0 .55rem; color: #38bdf8; font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
	.atlas-current h4 { min-height: 4rem; margin: 0; color: #f8fafc; font-size: 1.35rem; line-height: 1.35; letter-spacing: -.025em; }
	.atlas-current-result { margin: .9rem 0 0; color: #facc15; font-size: .8rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
	.atlas-current-venue { display: flex; align-items: flex-start; gap: .45rem; margin: .8rem 0 0; color: #cbd5e1; font-size: .72rem; font-weight: 600; line-height: 1.45; }
	.atlas-current-venue svg { width: .9rem; height: .9rem; flex: 0 0 auto; margin-top: .05rem; fill: none; stroke: #38bdf8; stroke-width: 1.7; }
	.atlas-current-copy { min-height: 4.5rem; margin: .7rem 0 0; color: #94a3b8; font-size: .84rem; line-height: 1.65; }

	.atlas-stops {
		position: relative;
		display: grid;
		grid-template-columns: repeat(7, minmax(0, 1fr));
		gap: 0;
		margin: 2rem 0 0;
		padding-top: 1.5rem;
	}

	.atlas-stops::before {
		content: '';
		position: absolute;
		top: 1.76rem;
		left: 8%;
		right: 8%;
		height: 1px;
		background: #334155;
	}

	.atlas-stop {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: 0;
		padding: 0 .15rem;
		border: 0;
		background: transparent;
		color: #64748b;
		cursor: pointer;
	}

	.atlas-stop-dot {
		position: relative;
		z-index: 1;
		width: .55rem;
		height: .55rem;
		margin-bottom: .7rem;
		border: 2px solid #475569;
		border-radius: 50%;
		background: #0f172a;
		transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease, background .25s ease;
	}

	.atlas-stop.active .atlas-stop-dot,
	.atlas-stop:hover .atlas-stop-dot,
	.atlas-stop:focus-visible .atlas-stop-dot {
		border-color: #f8fafc;
		background: var(--stop-color);
		box-shadow: 0 0 0 5px color-mix(in srgb, var(--stop-color) 18%, transparent), 0 0 16px var(--stop-color);
		transform: scale(1.15);
	}

	.atlas-stop:focus-visible { outline: 1px solid #38bdf8; outline-offset: .4rem; border-radius: .2rem; }
	.atlas-stop-year { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .62rem; letter-spacing: .08em; }
	.atlas-stop-name { max-width: 4rem; margin-top: .3rem; overflow: hidden; color: #94a3b8; font-size: .63rem; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
	.atlas-stop.active .atlas-stop-year, .atlas-stop.active .atlas-stop-name { color: #e2e8f0; }

	:global(.competition-atlas .mapboxgl-ctrl-group) { overflow: hidden; border: 1px solid rgba(148, 163, 184, .18); border-radius: .65rem; background: rgba(2, 6, 23, .65); box-shadow: none; backdrop-filter: blur(8px); }
	:global(.competition-atlas .mapboxgl-ctrl-group button) { width: 2rem; height: 2rem; }
	:global(.competition-atlas .mapboxgl-ctrl-group button + button) { border-top-color: rgba(148, 163, 184, .16); }
	:global(.competition-atlas .mapboxgl-ctrl-icon) { filter: invert(1) opacity(.65); }
	:global(.competition-atlas .mapboxgl-ctrl-attrib) { color: #64748b; background: rgba(2, 6, 23, .68); }
	:global(.competition-atlas .mapboxgl-ctrl-attrib a) { color: #94a3b8; }
