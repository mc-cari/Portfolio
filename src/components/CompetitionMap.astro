		zoom: 7,
		color: '#a4ac86',
		logo: '/brands/uach.png',
		logoAlt: 'Universidad Austral de Chile crest',
		markerTheme: 'light',
		markerPreset: 'uach',
		markerOffset: [0, 0],
	},
	{
		id: 'baku-2019',
