---

<div class="competition-atlas" data-competition-atlas data-mapbox-token={mapboxToken}>
	<div class="atlas-shell">
		<div class="atlas-map-wrap">
			<div id="competition-map" class="atlas-map" aria-label="Interactive globe showing Mauricio's in-person competition history"></div>
			<div class="atlas-map-fallback" aria-hidden="true">
				<div class="fallback-orbit fallback-orbit-one"></div>
				<div class="fallback-orbit fallback-orbit-two"></div>
				<div class="fallback-route"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
				<p><strong>07</strong> stops across <strong>03</strong> continents</p>
			</div>
			<div class="atlas-map-vignette" aria-hidden="true"></div>
			<div class="atlas-map-status" data-map-status>
				<span class="atlas-loader" aria-hidden="true"></span>
				<span>Loading map…</span>
			</div>
			<button
				type="button"
				class="atlas-play"
				data-map-play
				data-map-idle-label={mapPlayLabels.idle}
				data-map-playing-label={mapPlayLabels.playing}
				aria-pressed="false"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 8 6-8 6V6Z"/></svg>
				<span data-map-play-label>{mapPlayLabels.idle}</span>
			</button>
		</div>

		<aside class="atlas-story" aria-label="Competition journey timeline">
			<div class="atlas-current" aria-live="polite">
				<div class="atlas-current-topline">
					<span data-detail-year>2019</span>
					<span data-detail-progress>01 / 07</span>
				</div>
				<p class="atlas-current-place"><span data-detail-city>Valdivia</span>, <span data-detail-country>Chile</span></p>
				<h4 data-detail-event>Competitive Programming Training Camp</h4>
				<p class="atlas-current-result" data-detail-result>Training camp</p>
				<p class="atlas-current-venue">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11Z"/><circle cx="12" cy="10" r="2"/></svg>
					<span data-detail-venue>Universidad Austral de Chile</span>
				</p>
				<p class="atlas-current-copy" data-detail-copy>Competitive-programming training camp at Universidad Austral de Chile.</p>
			</div>

			<div class="atlas-stops">
				{stops.map((stop, index) => (
					<button
						type="button"
						class:list={['atlas-stop', { active: index === 0 }]}
						data-stop-index={index}
						aria-pressed={index === 0 ? 'true' : 'false'}
					>
						<span class="atlas-stop-dot" style={`--stop-color: ${stop.color}`}></span>
						<span class="atlas-stop-year">{stop.year}</span>
						<span class="atlas-stop-name">{stop.city}</span>
					</button>
				))}
			</div>

		</aside>
	</div>
	<script is:inline type="application/json" data-map-stops set:html={JSON.stringify(stops)}></script>
</div>

<script>
	import type { Map as MapboxMap } from 'mapbox-gl';

	type Stop = {
		id: string;
		city: string;
		country: string;
		year: string;
		event: string;
		result: string;
		detail: string;
		venue: string;
		coordinates: [number, number];
		zoom: number;
		color: string;
		logo: string;
		logoAlt: string;
		markerTheme: string;
		markerPreset: string;
		markerOffset: [number, number];
	};

	const atlas = document.querySelector<HTMLElement>('[data-competition-atlas]');

	if (atlas) {
		const stopData = atlas.querySelector<HTMLScriptElement>('[data-map-stops]');
		const stops: Stop[] = stopData ? JSON.parse(stopData.textContent || '[]') : [];
		const token = atlas.dataset.mapboxToken || '';
		const status = atlas.querySelector<HTMLElement>('[data-map-status]');
		const mapElement = atlas.querySelector<HTMLElement>('#competition-map');
		const mapWrap = atlas.querySelector<HTMLElement>('.atlas-map-wrap');
		const stopButtons = [...atlas.querySelectorAll<HTMLButtonElement>('[data-stop-index]')];
		const playButton = atlas.querySelector<HTMLButtonElement>('[data-map-play]');
		const playLabel = atlas.querySelector<HTMLElement>('[data-map-play-label]');
		const idlePlayLabel = playButton?.dataset.mapIdleLabel ?? '';
		const playingPlayLabel = playButton?.dataset.mapPlayingLabel ?? '';
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let map: MapboxMap | undefined;
		let mapMarkerElements: HTMLButtonElement[] = [];
		const markerDepartureTimers = new WeakMap<HTMLButtonElement, number>();
		let activeIndex = 0;
		let isPlaying = false;
		let playbackSession = 0;

		const setText = (selector: string, value: string) => {
			const element = atlas.querySelector<HTMLElement>(selector);
			if (element) element.textContent = value;
		};

		const showStop = (index: number, moveCamera = true, cameraSpeed = prefersReducedMotion ? 100 : 0.42) => {
			const stop = stops[index];
			if (!stop) return;
			const previousIndex = activeIndex;
			activeIndex = index;
			setText('[data-detail-year]', stop.year);
			setText('[data-detail-progress]', `${String(index + 1).padStart(2, '0')} / ${String(stops.length).padStart(2, '0')}`);
			setText('[data-detail-city]', stop.city);
			setText('[data-detail-country]', stop.country);
			setText('[data-detail-event]', stop.event);
			setText('[data-detail-result]', stop.result);
			setText('[data-detail-venue]', stop.venue);
			setText('[data-detail-copy]', stop.detail);
			stopButtons.forEach((button, buttonIndex) => {
				const selected = buttonIndex === index;
				button.classList.toggle('active', selected);
				button.setAttribute('aria-pressed', String(selected));
			});
			mapMarkerElements.forEach((marker, markerIndex) => {
				const selected = markerIndex === index;
				const departureTimer = markerDepartureTimers.get(marker);
				if (departureTimer) window.clearTimeout(departureTimer);
				marker.classList.remove('departing');
				marker.classList.toggle('active', selected);
				if (!selected && markerIndex === previousIndex) {
					marker.classList.add('departing');
					markerDepartureTimers.set(marker, window.setTimeout(() => {
						marker.classList.remove('departing');
						markerDepartureTimers.delete(marker);
					}, 420));
				}
				marker.setAttribute('aria-pressed', String(selected));
			});
			updateActiveMarkerZoom();
			if (map?.isStyleLoaded()) {
				if (moveCamera) {
					map.flyTo({
						center: stop.coordinates,
						zoom: stop.zoom,
						bearing: 0,
						pitch: 42,
						speed: cameraSpeed,
						curve: 0.8,
						essential: false,
					});
				}
			}
		};

		const setPlaying = (playing: boolean) => {
			isPlaying = playing;
			playButton?.setAttribute('aria-pressed', String(playing));
			if (playLabel) playLabel.textContent = playing ? playingPlayLabel : idlePlayLabel;
		};

		const stopJourney = () => {
			playbackSession += 1;
			map?.stop();
			setPlaying(false);
		};

		const wait = (milliseconds: number) => new Promise<void>((resolve) => window.setTimeout(resolve, milliseconds));
		const updateActiveMarkerZoom = () => {
			if (!map) return;
			const zoomDelta = Math.max(map.getZoom() - 1.25, 0);
			const markerScale = Math.min(2, 0.9 + zoomDelta * 0.28);
			const markerLift = Math.min(36, zoomDelta * 5.5);
			mapMarkerElements.forEach((marker, index) => {
				if (index === activeIndex) {
					const markerWidth = Number(marker.dataset.markerWidth || 0);
					const markerHeight = Number(marker.dataset.markerHeight || 0);
					marker.style.setProperty('--marker-render-width', `${(markerWidth * markerScale).toFixed(1)}px`);
					marker.style.setProperty('--marker-render-height', `${(markerHeight * markerScale).toFixed(1)}px`);
				} else {
					marker.style.removeProperty('--marker-render-width');
					marker.style.removeProperty('--marker-render-height');
					marker.style.setProperty('--marker-lift', '0px');
				}
				if (index === activeIndex) {
					marker.style.setProperty('--marker-lift', `${(-markerLift).toFixed(1)}px`);
				}
			});
		};
		const waitForCamera = () => new Promise<void>((resolve) => {
			if (!map?.isMoving()) {
				resolve();
				return;
			}
			map.once('moveend', () => resolve());
		});

		const playJourney = async () => {
			if (isPlaying) {
				stopJourney();
				return;
			}
			const session = ++playbackSession;
			setPlaying(true);
			let index = activeIndex;
			while (isPlaying && session === playbackSession) {
				showStop(index);
				await waitForCamera();
				if (!isPlaying || session !== playbackSession) return;
				await wait(prefersReducedMotion ? 1400 : 10000);
				if (!isPlaying || session !== playbackSession) return;
				index = (index + 1) % stops.length;
			}
		};

		stopButtons.forEach((button) => {
			button.addEventListener('click', () => {
				stopJourney();
				showStop(Number(button.dataset.stopIndex), true, prefersReducedMotion ? 100 : 0.9);
			});
		});
		playButton?.addEventListener('click', playJourney);

		const initMap = async () => {
			if (!mapElement || map || !stops.length) return;
			if (!token) {
				status?.classList.add('error');
				if (status) status.textContent = 'Interactive map unavailable here — use the timeline to explore each stop.';
				return;
			}
			const { default: mapboxgl } = await import('mapbox-gl');

			map = new mapboxgl.Map({
				container: mapElement,
				accessToken: token,
				style: 'mapbox://styles/mapbox/standard',
				config: {
					basemap: {
						theme: 'monochrome',
						lightPreset: 'night',
						show3dObjects: true,
						show3dBuildings: true,
						show3dTrees: true,
						show3dLandmarks: true,
						show3dFacades: true,
						showPointOfInterestLabels: false,
						colorLand: '#111d13',
						colorWater: '#050b06',
						colorGreenspace: '#2d4a2b',
						colorBuildings: '#445a40',
						colorPlaceLabels: '#d8dacd',
						colorRoadLabels: '#7d8471',
					},
				},
				projection: 'globe',
				center: stops[0].coordinates,
				zoom: 1.6,
				bearing: 0,
				pitch: 10,
				minZoom: 0.8,
				maxZoom: 16,
				cooperativeGestures: true,
				attributionControl: false,
			});
			map.addControl(new mapboxgl.NavigationControl({ showCompass: false }), 'top-right');
			map.addControl(new mapboxgl.AttributionControl({ compact: true }), 'bottom-left');

			map.on('style.load', () => {
				map?.setFog({
					color: 'rgb(28, 43, 30)',
					'high-color': 'rgb(8, 16, 9)',
					'horizon-blend': 0.08,
					'space-color': 'rgb(3, 8, 4)',
					'star-intensity': 0.28,
				});
			});
			map.on('zoom', updateActiveMarkerZoom);
			map.on('moveend', updateActiveMarkerZoom);

			map.on('load', () => {
				mapWrap?.classList.add('map-ready');
				mapMarkerElements = stops.map((stop, index) => {
					const marker = document.createElement('button');
					marker.type = 'button';
					marker.className = 'atlas-map-marker';
					marker.setAttribute('aria-label', `Show ${stop.event} in ${stop.city}`);
					marker.setAttribute('aria-pressed', String(index === activeIndex));
					const card = document.createElement('span');
					card.className = `atlas-map-marker-card ${stop.markerTheme} marker-${stop.markerPreset}`;
					const pin = document.createElement('span');
					pin.className = 'atlas-map-marker-pin';
					const logo = document.createElement('img');
					logo.src = stop.logo;
					logo.alt = stop.logoAlt;
					logo.className = 'atlas-map-marker-logo';
					logo.decoding = 'async';
					const tip = document.createElement('span');
					tip.className = 'atlas-map-marker-tip';
					card.append(logo);
					pin.append(card, tip);
					marker.append(pin);
					marker.classList.toggle('active', index === activeIndex);
					marker.addEventListener('click', (event) => {
						event.stopPropagation();
						stopJourney();
						showStop(index);
					});

					new mapboxgl.Marker({ element: marker, anchor: 'bottom', offset: stop.markerOffset })
						.setLngLat(stop.coordinates)
						.addTo(map as MapboxMap);
					marker.dataset.markerWidth = String(card.offsetWidth);
					marker.dataset.markerHeight = String(card.offsetHeight);
					marker.setAttribute('role', 'button');
					return marker;
				});
				showStop(activeIndex, false);
				updateActiveMarkerZoom();
				status?.classList.add('loaded');
			});

			map.on('error', (event) => {
				if (!map?.loaded() && status) {
					status.classList.add('error');
					status.textContent = 'The map could not load. The journey is still available in the timeline.';
				}
				console.error('Competition map error:', event.error);
			});
		};

		if ('IntersectionObserver' in window) {
			const observer = new IntersectionObserver((entries) => {
				if (entries.some((entry) => entry.isIntersecting)) {
					initMap();
					observer.disconnect();
				}
			}, { rootMargin: '300px' });
			observer.observe(atlas);
		} else {
			initMap();
		}
	}
</script>

<style>
	.competition-atlas {
		margin: 4rem auto 0;
		max-width: 72rem;
		container-type: inline-size;
	}

	.atlas-heading {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(16rem, 28rem);
		align-items: end;
		gap: 2rem;
		margin-bottom: 1.5rem;
	}

	.atlas-heading h3 {
		margin: 0;
		color: #faf9f6;
		font-size: clamp(1.6rem, 3vw, 2.25rem);
		font-weight: 700;
		letter-spacing: -.035em;
	}

	.atlas-intro {
		margin: 0;
		color: #7d8471;
		font-size: .92rem;
		line-height: 1.65;
	}

	.atlas-shell {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		overflow: hidden;
		border: 1px solid rgba(164, 172, 134, .24);
		border-radius: 1.25rem;
		background: #0d1a0f;
		box-shadow: 0 30px 80px rgba(2, 8, 3, .48), inset 0 1px 0 rgba(250, 249, 246, .035);
	}

	.atlas-map-wrap {
		position: relative;
		min-height: 32rem;
		isolation: isolate;
	}

	.atlas-map {
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 52% 45%, #2d4a2b, #050b06 72%);
	}

	.atlas-map-fallback {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		overflow: hidden;
		background:
			radial-gradient(circle at 52% 44%, rgba(198, 213, 143, .12), transparent 13rem),
			linear-gradient(rgba(198, 213, 143, .06) 1px, transparent 1px),
			linear-gradient(90deg, rgba(198, 213, 143, .06) 1px, transparent 1px),
			#071009;
		background-size: auto, 4rem 4rem, 4rem 4rem, auto;
		transition: opacity .45s ease, visibility .45s ease;
	}

	.atlas-map-wrap.map-ready .atlas-map-fallback {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.atlas-map-fallback p {
		position: relative;
		z-index: 1;
		margin: 15rem 0 0;
		color: #8e9f8b;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: .7rem;
		letter-spacing: .08em;
		text-transform: uppercase;
	}

	.atlas-map-fallback strong { color: #c6d58f; font-size: 1rem; }
	.fallback-orbit { position: absolute; border: 1px solid rgba(198, 213, 143, .15); border-radius: 50%; transform: rotate(-18deg); }
	.fallback-orbit-one { width: 30rem; height: 16rem; }
	.fallback-orbit-two { width: 23rem; height: 11rem; transform: rotate(28deg); }
	.fallback-route { position: absolute; top: 43%; left: 20%; right: 20%; display: flex; justify-content: space-between; align-items: center; transform: rotate(-14deg); }
	.fallback-route::before { content: ''; position: absolute; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(226, 173, 114, .65), transparent); }
	.fallback-route span { position: relative; z-index: 1; width: .55rem; height: .55rem; border: 2px solid #c6d58f; border-radius: 50%; background: #071009; box-shadow: 0 0 0 .4rem rgba(198, 213, 143, .08); }

	.atlas-map-vignette {
		position: absolute;
		z-index: 1;
		inset: 0;
		pointer-events: none;
		box-shadow: inset -50px 0 70px -45px #0d1a0f, inset 0 -70px 80px -70px #071009;
	}

	.atlas-map-status {
		position: absolute;
		z-index: 3;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: .75rem;
		color: #7d8471;
		font-size: .8rem;
		letter-spacing: .04em;
		background: radial-gradient(circle at center, rgba(45, 74, 43, .45), rgba(7, 16, 9, .94));
		transition: opacity .5s ease, visibility .5s ease;
	}

	.atlas-map-status.loaded {
		opacity: 0;
		visibility: hidden;
	}

	.atlas-map-status.error {
		padding: 2rem;
		color: #fda4af;
		text-align: center;
	}

	.atlas-loader {
		width: .85rem;
		height: .85rem;
		border: 1px solid rgba(164, 172, 134, .25);
		border-top-color: #a4ac86;
		border-radius: 50%;
		animation: atlas-spin 1s linear infinite;
	}

	.atlas-play {
		position: absolute;
		z-index: 2;
		right: 1rem;
		bottom: 1rem;
		display: flex;
		align-items: center;
		gap: .5rem;
		padding: .55rem .8rem;
		border: 1px solid rgba(164, 172, 134, .2);
		border-radius: 999px;
		background: rgba(7, 16, 9, .78);
		backdrop-filter: blur(10px);
		color: #7d8471;
		font-size: .65rem;
