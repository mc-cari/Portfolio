		markerTheme: 'light',
		markerPreset: 'tcarg',
		markerOffset: [0, 0],
	},
	{
		id: 'coquimbo-2023',
		city: 'Coquimbo',
		country: 'Chile',
		year: '2023',
		venue: 'Universidad Católica del Norte · Campus Guayacán',
		event: 'ICPC Latin American Regional',
		result: '#23 in Latin America',
		detail: 'Achieved 23rd place among 309 teams in Latin America.',
		coordinates: [-71.351, -29.96495],
		zoom: 7,
		color: '#7d8471',
		logo: '/brands/icpc-foundation-portrait.png',
		logoAlt: 'ICPC Foundation logo',
