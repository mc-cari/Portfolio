		venue: 'University of Campinas · Unicamp',
		event: 'Brazilian ICPC Summer School',
		result: 'Training camp',
		detail: 'Attended the World Final Class in Campinas: 85 hours of training, from January 23 to February 4.',
		coordinates: [-47.0647, -22.8176],
		zoom: 7,
		color: '#a4ac86',
		logo: '/brands/unicamp.svg',
		logoAlt: 'Unicamp logo',
		markerTheme: 'light',
		markerPreset: 'unicamp',
