		zoom: 7,
		color: '#a4ac86',
		logo: '/brands/codevita-season11.png',
		logoAlt: 'TCS CodeVita Season XI Mumbai logo',
		markerTheme: 'dark',
		markerPreset: 'codevita11',
		markerOffset: [0, 0],
	},
	{
		id: 'chennai-2025',
		city: 'Chennai',
		country: 'India',
		year: '2025',
		venue: 'TCS Siruseri Campus',
		event: 'TCS CodeVita Season 12',
		result: '#4 worldwide',
		detail: 'Achieved 4th place in the Grand Finale out of 25 participants and 100,000+ overall participants.',
		coordinates: [80.21772, 12.82955],
		zoom: 7,
		color: '#faf9f6',
		logo: '/brands/codevita-season12-wide.png',
		logoAlt: 'TCS CodeVita Season XII logo',
