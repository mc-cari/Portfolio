---
const roles = [
	{ title: 'Research Intern', company: 'National Institute of Informatics', period: 'Sep 2024 - Mar 2025', place: 'Tokyo, Japan', bullets: ['Conducted research on real-time UAV flight conformance verification in Tokyo airspace using smart contracts.', 'Worked with a Java simulator for Unmanned Aircraft System Traffic Management (UTM) to enhance resilience and scalability.'] },
	{ title: 'Software Engineer Intern', company: 'Nirvana Insurance', period: 'Dec 2023 - Feb 2024', place: 'Santiago, Chile', bullets: ['Developed a scheduled task in Go to automatically calculate fleet scores in PostgreSQL upon new data availability, reducing fleet score retrieval times by 70%.', 'Designed a Quota Manager that dynamically sets and updates request limits for the usage of third-party APIs with variable per-request costs, reducing overspending by 80%.', 'Implemented a Quota Manager server with gRPC, Redis, and PostgreSQL that can register and update new quotas at runtime and handle up to 100 million concurrent requests from internal services monthly.'] },
];
---

<section id="experience" class="py-20 md:py-32">
	<div class="text-center"><h2 class="text-3xl md:text-4xl font-bold text-slate-100">Professional Experience</h2></div>
	<div class="mt-16 max-w-4xl mx-auto space-y-8">
		{roles.map((role) => (
			<div class="glass-card rounded-2xl p-8 hover:scale-[1.02] transition-all duration-300">
				<div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
					<div><h3 class="text-2xl font-bold text-slate-100">{role.title}</h3><p class="text-sky-400 font-semibold text-lg">{role.company}</p></div>
					<div class="mt-2 md:mt-0 text-right"><div class="inline-flex items-center px-4 py-2 bg-sky-500/20 text-sky-300 rounded-full text-sm font-medium">{role.period}</div><p class="text-slate-400 text-sm mt-1">{role.place}</p></div>
				</div>
				<div class="space-y-3">
					{role.bullets.map((bullet) => <div class="flex items-start space-x-3"><div class="w-2 h-2 bg-sky-400 rounded-full mt-2 flex-shrink-0"></div><p class="text-slate-300">{bullet}</p></div>)}
					{role.company === 'Nirvana Insurance' && <div class="flex items-start space-x-3"><div class="w-2 h-2 bg-sky-400 rounded-full mt-2 flex-shrink-0"></div><p class="text-slate-300">Read more about the experience in the following blog post: <a href="https://engblog.nirvanatech.com/meet-the-interns-pt-3-mauricio-cari-f4ba2d6d463a" target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:text-sky-300 underline">Meet the Interns</a>.</p></div>}
				</div>
			</div>
		))}
	</div>
</section>
