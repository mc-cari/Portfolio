---
import CompetitionMap from '../CompetitionMap.astro';
import { Image } from 'astro:assets';
import ioiPhoto from '../../assets/International Olympiad in Informatics.png';
import ioiLogo from '../../assets/brands/ioi-2019.png';
import codevitaPhoto from '../../assets/TCS Codevita 2025.jpeg';
import codevitaLogo from '../../assets/brands/codevita.png';

const remoteCompetitions = [
	{ title: 'TCS CodeVita Season 10', result: '#2 Worldwide', year: '2022', tone: 'text-green-400', copy: 'After three qualification rounds, I was awarded 2nd place out of 30 participants in the Guinness World Record-holding competition for the largest computer programming contest with 100,000+ participants overall rounds.' },
	{ title: 'Google Code Jam 2022', result: '#483 in Round 3', year: '2022', tone: 'text-indigo-400', copy: 'Achieved rank 483 in Round 3 among 1000 participants.' },
	{ title: 'IEEExtreme 15.0 Programming Competition', result: '#17 Worldwide', year: '2021', tone: 'text-violet-400', copy: 'Finished 17th out of 2,400 teams in the 24-hour contest, using C++ with team offByOneKenobi.' },
];
---

	<section id="competitive-programming" class="section-shell">
	<div class="section-heading centered">
		<h2 class="section-title">Competitive Programming</h2>
		<p class="mt-6 body-copy">I've participated in coding competitions since high school and later joined my university's competitive programming team. It has been an incredible experience, from coding camps in Chile, Argentina, and Brazil to international finals.</p>
	</div>

	<CompetitionMap />

	<div class="mt-10 max-w-5xl mx-auto grid grid-cols-1 gap-6 md:grid-cols-2">
		<figure class="group relative overflow-hidden rounded-xl border border-[#a4ac86]/20 bg-[#152519]/70 shadow-xl shadow-black/20">
			<div class="relative aspect-[4/3] overflow-hidden bg-[#071009]">
				<Image src={ioiPhoto} alt="Mauricio competing for Chile at IOI 2019 in Baku" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.035]" />
				<div class="absolute inset-0 bg-gradient-to-t from-[#071009]/90 via-transparent to-transparent" aria-hidden="true"></div>
				<div class="absolute left-4 top-4 flex h-20 w-20 items-center justify-center rounded-xl border border-white/20 bg-white/95 p-2 shadow-xl backdrop-blur">
					<Image src={ioiLogo} alt="IOI 2019 Baku logo" class="h-full w-full object-contain" />
				</div>
			</div>
			<figcaption class="absolute inset-x-4 bottom-4 text-left text-sm font-bold text-white">Representing Chile at IOI 2019 <span class="block mt-1 text-xs font-medium text-white/70">Baku, Azerbaijan</span></figcaption>
		</figure>

		<figure class="group relative overflow-hidden rounded-xl border border-[#a4ac86]/20 bg-[#152519]/70 shadow-xl shadow-black/20">
			<div class="relative aspect-[4/3] overflow-hidden bg-[#071009]">
				<Image src={codevitaPhoto} alt="Mauricio receiving his TCS CodeVita Season 12 award" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.035]" />
				<div class="absolute inset-0 bg-gradient-to-t from-[#071009]/90 via-transparent to-transparent" aria-hidden="true"></div>
				<div class="absolute left-4 top-4 flex h-14 w-44 items-center justify-center rounded-xl border border-white/15 bg-[#071009]/90 px-4 shadow-xl backdrop-blur">
					<Image src={codevitaLogo} alt="TCS CodeVita" class="h-auto w-full object-contain" />
				</div>
			</div>
			<figcaption class="absolute inset-x-4 bottom-4 text-left text-sm font-bold text-white">CodeVita Season 12 Grand Finale <span class="block mt-1 text-xs font-medium text-white/70">Chennai, India · #4 worldwide</span></figcaption>
		</figure>
	</div>

	<div class="mt-20 text-center">
		<h3 class="text-3xl md:text-4xl font-bold text-[#faf9f6]">Remote competitions</h3>
	</div>
	<div class="mt-10 max-w-5xl mx-auto space-y-6">
		{remoteCompetitions.map((competition) => (
			<article class="glass-card rounded-xl p-7 transition-all duration-300 hover:-translate-y-1 hover:border-[#a4ac86]/40 md:p-8">
				<div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4"><div><h3 class="text-2xl font-bold text-[#faf9f6]">{competition.title}</h3><p class="font-semibold text-lg text-[#a4ac86]">{competition.result}</p></div><div class="mt-4 md:mt-0 md:text-right"><div class="text-3xl font-bold text-[#a4ac86]">{competition.year}</div><p class="text-[#7d8471]">Remote</p></div></div>
				<p class="leading-relaxed text-[#d8dacd]">{competition.copy}</p>
			</article>
		))}
	</div>
</section>
