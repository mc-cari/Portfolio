---
import CompetitionMap from '../CompetitionMap.astro';

const remoteCompetitions = [
	{ title: 'TCS CodeVita Season 10', result: '#2 Worldwide', year: '2022', tone: 'text-green-400', copy: 'After three qualification rounds, I was awarded 2nd place out of 30 participants in the Guinness World Record-holding competition for the largest computer programming contest with 100,000+ participants overall rounds.' },
	{ title: 'Google Code Jam 2022', result: '#483 in Round 3', year: '2022', tone: 'text-indigo-400', copy: 'Achieved rank 483 in Round 3 among 1000 participants.' },
	{ title: 'IEEExtreme 15.0 Programming Competition', result: '#17 Worldwide', year: '2021', tone: 'text-violet-400', copy: 'Finished 17th out of 2,400 teams in the 24-hour contest, using C++ with team offByOneKenobi.' },
];
---

<section id="competitive-programming" class="py-20 md:py-32">
	<div class="text-center"><h2 class="text-3xl md:text-4xl font-bold text-slate-100">Competitive Programming</h2><p class="mt-4 max-w-2xl mx-auto text-lg text-slate-400">I've participated in coding competitions since high school and later joined my university's competitive programming team. It has been an incredible experience, where I had the opportunity to practice in coding camps in Chile, Argentina, and Brazil, and qualify for international competitions.</p></div>
	<CompetitionMap />
	<div class="mt-16 max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-6"><img src="/TCS Codevita 2025.jpeg" alt="TCS CodeVita 2025 Competition" class="rounded-lg w-full h-auto shadow-lg aspect-video object-cover"><img src="/International Olympiad in Informatics.png" alt="International Olympiad in Informatics" class="rounded-lg w-full h-auto shadow-lg aspect-video object-cover"></div>
	<div class="mt-16 text-center"><h3 class="text-2xl md:text-3xl font-bold text-slate-100">Remote competitions</h3></div>
	<div class="mt-16 max-w-5xl mx-auto space-y-8">
		{remoteCompetitions.map((competition) => (
			<div class="glass-card rounded-2xl p-8 hover:scale-[1.02] transition-all duration-300">
				<div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4"><div><h3 class="text-2xl font-bold text-slate-100">{competition.title}</h3><p class:list={['font-semibold text-lg', competition.tone]}>{competition.result}</p></div><div class="mt-4 md:mt-0 text-right"><div class:list={['text-3xl font-bold', competition.tone]}>{competition.year}</div><p class="text-slate-400">Remote</p></div></div>
				<p class="text-slate-300">{competition.copy}</p>
			</div>
		))}
	</div>
</section>
